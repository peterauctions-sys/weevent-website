---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../lib/types';
import { t } from '../lib/i18n';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  currentPage?: string;
}

const { lang, title, description, currentPage = '' } = Astro.props;
const content = t(lang);
const fullTitle = title.includes('WE') ? title : `${title} | WE Displays`;
---

<!doctype html>
<html lang={content.locale} dir={content.dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description ?? content.tagline} />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <Header lang={lang} currentPage={currentPage} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      const toggle = document.querySelector('.menu-toggle');
      const mobileNav = document.querySelector('.mobile-nav');
      toggle?.addEventListener('click', () => {
        const open = mobileNav?.classList.toggle('open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    </script>
  </body>
</html>
