---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLang, t } from '../../lib/i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const lang = getLang(Astro.params.lang);
const c = t(lang);
---

<BaseLayout lang={lang} title={c.contact.metaTitle} currentPage="contact">
  <div class="page-hero">
    <div class="container">
      <h1>{c.contact.title}</h1>
      <p>{c.contact.intro}</p>
      <p style="margin-top:1rem;">
        <a href="https://www.we-events.co.nz" target="_blank" rel="noopener" style="font-weight:700;">
          {c.contact.website}
        </a>
      </p>
    </div>
  </div>

  <section class="section">
    <div class="container contact-grid">
      {
        c.contact.people.map((person) => (
          <article class="contact-card">
            <h3 style="margin:0 0 0.25rem; color: var(--navy);">{person.name}</h3>
            <p class="team-role" style="margin-bottom:1rem;">{person.role}</p>
            <p>
              <a href={`mailto:${person.email}`}>{person.email}</a>
            </p>
            <p>
              <a href={`tel:${person.phone.replace(/\s/g, '')}`}>{person.phone}</a>
            </p>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
